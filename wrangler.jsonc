{
  "name": "ad-ilinden-struga",
  "compatibility_date": "2026-11-05",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "ilindenad@gmail.com"
    }
  ],
  "ratelimits": [
    {
      "name": "FORM_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
